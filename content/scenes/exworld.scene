game EXWORLD {
  world ExWorld {
    // Flat terrain: the procedural city sits on its own streets at y=0.
    // Amplitude 0 keeps hills from poking through downtown.
    terrain ExTerrain { amplitude = 0 seed = 60611 chunk_size = 32 resolution = 33 sea_level = 0 }

    player Sebastian { x = 0 y = 1.8 z = 12 }
    npc DawnOfLight { x = 3.2 y = 1.8 z = 16 }

    // === COUNTRYSIDE (outside the city grid, placed by hand) ===

    // Forest (~780m west, 440m north)
    building RangerCabin { x = -780 y = 0 z = 440 floors = 1 rooms = 3 doors = 1 windows = 4 stairs = 0 furniture = 4 seed = 301 }
    building ForestLodge { x = -820 y = 0 z = 480 floors = 2 rooms = 4 doors = 1 windows = 6 stairs = 1 furniture = 5 seed = 302 }
    vehicle ForestPickup { x = -775 y = 0.5 z = 448 type = Pickup }
    npc Hiker_01 { x = -790 y = 1.8 z = 455 }
    npc Hiker_02 { x = -810 y = 1.8 z = 470 }

    // Lake (~640m east, 500m south)
    building LakesideDock { x = 640 y = 0 z = -500 floors = 1 rooms = 2 doors = 1 windows = 2 stairs = 0 furniture = 2 seed = 401 }
    building BoatHouse { x = 670 y = 0 z = -540 floors = 1 rooms = 3 doors = 1 windows = 3 stairs = 0 furniture = 3 seed = 402 }
    vehicle LakeSedan { x = 645 y = 0.4 z = -510 type = Car }
    npc Fisher_01 { x = 650 y = 1.8 z = -505 }
    npc Fisher_02 { x = 660 y = 1.8 z = -530 }

    // Swamp (~-410, -710)
    building MarshShack { x = -410 y = 0 z = -710 floors = 1 rooms = 2 doors = 1 windows = 2 stairs = 0 furniture = 2 seed = 501 }
    building SwampHut { x = -450 y = 0 z = -740 floors = 1 rooms = 2 doors = 1 windows = 2 stairs = 0 furniture = 2 seed = 502 }
    vehicle SwampPickup { x = -415 y = 0.5 z = -715 type = Pickup }
    npc MarshPed_01 { x = -420 y = 1.8 z = -720 }
  }
}
